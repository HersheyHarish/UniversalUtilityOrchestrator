{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://uuo.dev/schemas/agents.schema.json",
    "title": "UUO Agent Registry",
    "description": "Schema for the Universal Utility Orchestrator agent registry. Each agent entry describes a plug-and-play microservice the orchestrator can discover and invoke.",
    "type": "object",
    "required": ["agents"],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to this schema file."
        },
        "agents": {
            "type": "array",
            "description": "List of registered agents available to the orchestrator.",
            "items": {
                "$ref": "#/definitions/Agent"
            }
        }
    },
    "definitions": {
        "Agent": {
            "type": "object",
            "description": "A single plug-and-play agent definition.",
            "required": ["name", "description", "capabilities", "endpoint"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Unique machine-readable identifier for this agent (snake_case recommended).",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "examples": ["billing_agent", "anomaly_detection_agent"]
                },
                "version": {
                    "type": "string",
                    "description": "Semantic version of this agent. Used for compatibility checks.",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$",
                    "default": "1.0.0",
                    "examples": ["1.0.0", "2.1.3"]
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Set to false to exclude this agent from the registry without removing its definition.",
                    "default": true
                },
                "status": {
                    "type": "string",
                    "description": "Lifecycle status of the agent. Only 'active' agents are eligible for orchestration.",
                    "enum": ["active", "inactive", "maintenance"],
                    "default": "active"
                },
                "description": {
                    "type": "string",
                    "description": "Human-readable summary of what this agent does.",
                    "minLength": 10
                },
                "capabilities": {
                    "type": "array",
                    "description": "List of natural-language capability statements the orchestrator uses for agent selection.",
                    "items": {
                        "type": "string",
                        "minLength": 5
                    },
                    "minItems": 1
                },
                "tags": {
                    "type": "array",
                    "description": "Short keywords for grouping, filtering, and discovery.",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "uniqueItems": true,
                    "default": []
                },
                "endpoint": {
                    "type": "string",
                    "description": "HTTP(S) base URL the orchestrator POSTs task payloads to.",
                    "format": "uri",
                    "examples": ["http://localhost:8001/billing_agent"]
                },
                "health_check": {
                    "type": "string",
                    "description": "Optional HTTP GET endpoint the orchestrator can poll to verify the agent is alive.",
                    "format": "uri",
                    "examples": ["http://localhost:8001/health"]
                },
                "timeout_seconds": {
                    "type": "integer",
                    "description": "Per-agent HTTP timeout in seconds. Overrides the global orchestration timeout when set.",
                    "minimum": 1,
                    "maximum": 600,
                    "default": 30
                },
                "input_schema": {
                    "type": "object",
                    "description": "JSON Schema (draft-07) describing the payload this agent expects to receive.",
                    "default": {}
                },
                "output_schema": {
                    "type": "object",
                    "description": "JSON Schema (draft-07) describing the response payload this agent returns.",
                    "default": {}
                },
                "metadata": {
                    "type": "object",
                    "description": "Arbitrary key-value pairs for documentation, ownership, or tooling (e.g. author, created_at).",
                    "properties": {
                        "author": { "type": "string" },
                        "created_at": { "type": "string" },
                        "updated_at": { "type": "string" }
                    },
                    "additionalProperties": true,
                    "default": {}
                }
            }
        }
    }
}
