{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      }
    },
    "logLevel": {
      "default": "Information",
      "Function": "Information",
      "Host.Results": "Error"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api",
      "cors": {
        "allowedOrigins": [
          "http://localhost:5174",
          "http://localhost:3000",
          "http://127.0.0.1:5174",
          "http://127.0.0.1:3000",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "supportCredentials": true
      }
    }
  },
  "functionTimeout": "00:05:00"
}