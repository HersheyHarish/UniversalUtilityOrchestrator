# Copy to orchestrator/.env for local Docker or `func start`.
# Never commit real keys — .env is gitignored.

# ── Cosmos (local emulator defaults) ─────────────────────────────────────────
COSMOS_ENDPOINT=https://cosmos:8081/
COSMOS_DATABASE=utility_agent_db

# ── Azure OpenAI (required for planning/synthesis) ───────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_PLANNER_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Local dev: set API key directly (production uses Key Vault via OPENAI_SECRET_NAME)
AZURE_OPENAI_API_KEY=
OPENAI_SECRET_NAME=openai-api-key

# ── Key Vault (production / strict local) ────────────────────────────────────
KEY_VAULT_URL=

# ── Runtime mode ─────────────────────────────────────────────────────────────
APP_ENV=local
USE_LOCAL_EMULATORS=true
ORCHESTRATOR_HTTP_AUTH_LEVEL=ANONYMOUS
ORCHESTRATOR_STRICT_MODE=false

# ── Feature flags ────────────────────────────────────────────────────────────
ORCHESTRATOR_DEMO_STEPS=true
ORCHESTRATOR_STREAM_PROGRESS=true
ORCHESTRATOR_CHAT_STREAM_ENABLED=true
ORCHESTRATOR_PARALLEL_EXEC=true
ORCHESTRATOR_EVAL_ENABLED=false
ORCHESTRATOR_PLANNER_HISTORY_TURNS=6
ORCHESTRATOR_TRANSCRIPT_MAX_TURNS=20
ORCHESTRATOR_TRANSCRIPT_MAX_CHARS=12000

# ── Agent HTTP calls ─────────────────────────────────────────────────────────
AGENT_TIMEOUT_SECS=45
AGENT_MAX_RETRIES=2

# ── Build metadata (required when ORCHESTRATOR_STRICT_MODE=true or APP_ENV=prod)
BUILD_VERSION=dev
BUILD_SHA=local

# ── Optional: outage simulation file path ────────────────────────────────────
# OUTAGE_INPUT_FILE=
