# Copy this to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Base URL of your deployed registry function app
VITE_REGISTRY_URL=https://fn-registry-ua001.azurewebsites.net

# Function app host key (required only when backend auth level is FUNCTION)
VITE_FUNC_CODE=your_function_host_key_here
