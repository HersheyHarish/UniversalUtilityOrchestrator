# Root example for docker-compose local stack.
# Copy orchestrator/.env.example → orchestrator/.env and fill Azure OpenAI values.
# docker-compose reads orchestrator/.env via env_file.

# Cosmos emulator (Docker service name)
COSMOS_ENDPOINT=https://cosmos:8081/
COSMOS_DATABASE=utility_agent_db

# Optional: override Cosmos Docker image/platform (Apple Silicon)
# COSMOS_IMAGE=mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator:latest
# COSMOS_PLATFORM=linux/amd64
# COSMOS_MEM_LIMIT=3g
# COSMOS_CPUS=2.0
# COSMOS_IP_OVERRIDE=cosmos
